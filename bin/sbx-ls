#!/usr/bin/env bash
#
# sbx-ls — a human-friendly list of sandboxes. Flags orphans (no workspace) and
# stopped sandboxes, and prints a copy/paste `sbx-open` for each project.
#
set -euo pipefail

_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do _self="$(readlink "$_self")"; done
_bindir="$(cd "$(dirname "$_self")" && pwd)"
for _cand in "${SBX_CODEX_LIB:-}" "$_bindir/../lib/sbx-codex" "$_bindir/../lib"; do
  if [[ -n "$_cand" && -f "$_cand/common.sh" ]]; then _LIB="$_cand"; break; fi
done
[[ -n "${_LIB:-}" ]] || { echo "sbx-ls: cannot locate lib/" >&2; exit 1; }
# shellcheck source=lib/common.sh
source "$_LIB/common.sh"
# shellcheck source=lib/sbx-interface.sh
source "$_LIB/sbx-interface.sh"

PROG="sbx-ls"
case "${1:-}" in
  -h|--help) printf '%s — list sandboxes (flags orphans + stopped)\nUSAGE: %s\n' "$PROG" "$PROG"; exit 0 ;;
  -V|--version) printf '%s %s\n' "$PROG" "$(toolkit_version)"; exit 0 ;;
  "") ;;
  *) die "unknown option: $1" ;;
esac

sbx_present || die "'$SBX_BIN' not found on PATH."

rows="$(sbx_ls_normalized 2>/dev/null || true)"
if [[ -z "$rows" ]]; then
  info "No sandboxes yet. Create one with: sbx-open <path>"
  exit 0
fi

printf '%s%-20s %-8s %-9s %s%s\n' "$C_BOLD" "SANDBOX" "AGENT" "STATUS" "WORKSPACE" "$C_RESET"
orphans=0; stopped=0
while IFS=$'\t' read -r name agent status ws; do
  [[ -n "$name" ]] || continue
  tag=""
  if [[ -z "$ws" ]]; then tag=" ${C_RED}(orphan)${C_RESET}"; orphans=$((orphans+1)); ws="—"; fi
  if [[ "$status" == "stopped" ]]; then status="${C_YELLOW}stopped${C_RESET}"; stopped=$((stopped+1))
  elif [[ "$status" == "running" ]]; then status="${C_GREEN}running${C_RESET}"; fi
  printf '%-20s %-8s %-9b %s%b\n' "$name" "$agent" "$status" "$ws" "$tag"
done <<< "$rows"

echo ""
while IFS=$'\t' read -r name agent status ws; do
  [[ -n "$ws" && "$ws" != "—" ]] || continue
  hint "reopen: sbx-open '$ws'"
done <<< "$rows"

if [[ "$orphans" -gt 0 ]]; then
  warn "$orphans orphan sandbox(es) — reclaim them with: sbx-clean --orphans-only"
fi
if [[ "$stopped" -gt 0 ]]; then
  hint "$stopped stopped — reopen with sbx-open, or remove with: sbx-clean --stopped"
fi
