#!/usr/bin/env bash
# DEPRECATED SHIM — `sbx-clean` was renamed. Forwards to `sbx-ide clean`.
# Removed by `make uninstall`; flagged by `sbx-ide doctor`.
set -euo pipefail
_self="${BASH_SOURCE[0]}"; while [[ -L "$_self" ]]; do _self="$(readlink "$_self")"; done
_bindir="$(cd "$(dirname "$_self")" && pwd)"
printf '%s\n' "⚠️  sbx-clean is deprecated — use: sbx-ide clean" >&2
exec "$_bindir/sbx-ide" clean "$@"
